{
  "name": "apply",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n back,front -c blue,green \"npm run dev -w @apply/back\" \"npm run dev -w @apply/front\"",
    "build": "tsc -b && npm run build -w @apply/front",
    "typecheck": "tsc -b",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run --reporter=verbose",
    "coverage": "vitest run --coverage",
    "mutation": "stryker run",
    "mut:smoke": "MUTATION_SMOKE=1 stryker run && node scripts/check-smoke.mjs",
    "e2e": "playwright test",
    "claude:smoke": "npm run claude:smoke -w @apply/back",
    "db:up": "docker compose up -d --wait db",
    "db:down": "docker compose down",
    "db:generate": "npm run db:generate -w @apply/back",
    "db:migrate": "npm run db:migrate -w @apply/back",
    "db:import": "npm run import -w @apply/back",
    "match:calibrate": "npm run match:calibrate -w @apply/back --"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.9",
    "@playwright/test": "1.65.1",
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/vitest-runner": "10.1.1",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "5.1.2",
    "concurrently": "^10.0.7",
    "typescript": "7.0.2",
    "vitest": "5.1.2"
  },
  "allowScripts": {
    "onnxruntime-node@1.30.0": true,
    "protobufjs@7.6.6": true,
    "esbuild@0.28.2": true
  }
}
