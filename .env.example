# Clave de la API de Claude (o usa `ant auth login` y deja esto vacío)
ANTHROPIC_API_KEY=

# Opcionales
# CLAUDE_MODEL=claude-opus-5-5
# EMBED_MODEL=Xenova/multilingual-e5-small
# CHROME_PATH=/usr/bin/google-chrome-stable
# PORT=3001

# Postgres local (docker compose). Cambia la contraseña; `.env` no se versiona.
POSTGRES_PASSWORD=change-me
PG_PORT=5432
# Aísla contenedor y volumen por worktree (opcional)
# COMPOSE_PROJECT_NAME=apply
DATABASE_URL=postgres://apply:change-me@127.0.0.1:5432/apply

# OAuth de Google (Gmail)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
