# La API usa la CLI `claude` local con tu suscripción: no definas ANTHROPIC_*.
# Opcionales
# CLAUDE_BIN=claude
# CLAUDE_TIMEOUT_MS=600000
# CLAUDE_MODEL=claude-opus-5-5
# EMBED_MODEL=Xenova/multilingual-e5-small
# CHROME_PATH=/usr/bin/google-chrome-stable
# Opción "Con Chrome" de vacantes: usa tu Chrome abierto, con tus sesiones (p. ej. LinkedIn).
# Actívalo una vez en chrome://inspect/#remote-debugging. Carpeta de datos de ese Chrome:
# CHROME_USER_DATA_DIR=~/.config/google-chrome
# Sin tu Chrome: un Chrome headless con perfil temporal (solo páginas públicas).
# CHROME_MCP_HEADLESS=true
# PORT=3001

# Postgres local (docker compose). Cambia la contraseña; `.env` no se versiona.
POSTGRES_PASSWORD=change-me
PG_PORT=5432
# Aísla contenedor y volumen por worktree (opcional)
# COMPOSE_PROJECT_NAME=apply
DATABASE_URL=postgres://apply:change-me@127.0.0.1:5432/apply

# OAuth de Google (Gmail)
# Cliente OAuth de tipo "Desktop app" (loopback 127.0.0.1 + PKCE). Sin estas dos, Gmail queda
# "no configurado" y el registro manual sigue funcionando.
# El refresh token se guarda en APPLY_CONFIG_DIR (por defecto ~/.config/apply), nunca dentro del repo.
# APPLY_CONFIG_DIR=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Cada cuántos minutos se buscan respuestas de reclutadores en Gmail (por defecto 15).
# GMAIL_SYNC_MINUTES=15
